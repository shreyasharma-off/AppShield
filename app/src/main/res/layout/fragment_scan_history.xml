<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_scan_history.xml
    Screen: Scan History
    Contains a RecyclerView list, an empty-state message, and a Clear History button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Screen title -->
    <TextView
        android:id="@+id/tvScanHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp" />

    <!-- List of past scans; fills available space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Shown only when there are no scan records (visibility = GONE by default) -->
    <TextView
        android:id="@+id/tvEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/history_empty"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="16dp" />

    <!-- Clear History button, pinned to the bottom -->
    <Button
        android:id="@+id/btnClearHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/history_clear_button" />

</LinearLayout>
