<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="67dp"
    android:orientation="horizontal"
    android:paddingStart="13dp"
    android:paddingTop="11dp"
    android:paddingEnd="13dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/img_row_icon"
        android:layout_width="@dimen/row_icon"
        android:layout_height="@dimen/row_icon"
        android:background="@drawable/bg_row_icon"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_smartphone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_row_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/cd_arrow"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
