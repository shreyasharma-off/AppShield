<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_about.xml
    Settings / About screen — scrollable, with app name, about text,
    disclaimer, project information, and a "View Risk Methodology" button.
    A Toolbar provides the Up/Back arrow (the global theme is NoActionBar).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar provides the Up / Back button (NoActionBar theme) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAbout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:title="About" />

    <!-- Scrollable content below the toolbar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── App name & tagline ──────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAboutAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvAboutTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_tagline"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- ── About section ──────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAboutSectionAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_section_about"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvAboutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_body"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- ── Disclaimer section ─────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAboutSectionDisclaimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_section_disclaimer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvAboutDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_disclaimer"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- ── Project information section ───────────────────────────────── -->
        <TextView
            android:id="@+id/tvAboutSectionProject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_section_project"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvAboutProjectInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_project_info"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- ── View Risk Methodology button ──────────────────────────────── -->
        <Button
            android:id="@+id/btnViewMethodology"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/about_btn_methodology" />

    </LinearLayout>

</ScrollView>

</LinearLayout>
